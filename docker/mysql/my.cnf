[mysqld]
# Tuned for the 16-core / 64 GB workstation in SCALING-PLAN.md §4.
# ON A SMALLER MACHINE, change the buffer pool first: it is the one line that will stop MySQL from
# starting if the box does not have the RAM.
innodb_buffer_pool_size = 16G
innodb_buffer_pool_instances = 8

# The whole event is a few GB of rows once photos move out of the database (§3d), so the working set fits
# in memory and these are about write behaviour rather than cache size.
innodb_log_file_size = 1G
innodb_log_buffer_size = 64M
innodb_flush_method = O_DIRECT

# flush_log_at_trx_commit = 1 is the safe default and costs an fsync per commit. 2 survives a process
# crash but can lose ~1 s of commits on a power cut. There is no HA here (§8.4) and the box is on a UPS,
# so 2 is the deliberate trade: a one-second hole in a race log against every write waiting on the disk.
innodb_flush_log_at_trx_commit = 2

max_connections = 500
thread_cache_size = 64
table_open_cache = 4000

# 5,000 phones hold no sessions (they use tokens), so connections come and go with php-fpm children.
wait_timeout = 120
interactive_timeout = 120

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Anything slower than a tenth of a second during an event is worth reading afterwards.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 0.1
log_queries_not_using_indexes = 0

[client]
default-character-set = utf8mb4
