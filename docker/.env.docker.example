# EUREKA on the workstation. Copy to docker/.env and fill in the three secrets.
#
# This file is the stack's configuration; the application's own .env is generated from it by deploy.sh,
# so there is one place to edit rather than two that can disagree.

APP_NAME=Questerra
APP_ENV=production
APP_DEBUG=false
# MIGRATING an existing server? COPY this from the old .env, do not generate one. Login cards are
# Crypt-encrypted with it and the offline seal derives its salt from it, so a fresh key means cards that
# can never be reprinted and phones whose sealed questionnaires will not open. See docker/MIGRATION.md.
# A genuinely NEW install generates one: ./deploy.sh key
# Either way, `./deploy.sh doctor` decrypts a real card and tells you whether the key matches the data.
APP_KEY=
APP_URL=https://questerra-series.com
APP_TIMEZONE=UTC

# --- database ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eureka
DB_USERNAME=eureka
DB_PASSWORD=                  # set this
MYSQL_ROOT_PASSWORD=          # set this

# --- Redis: cache may forget, the queue may not ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=0
REDIS_QUEUE_CONNECTION=queue

# --- the point of phase 2: none of these touch MySQL any more ---
# Every player request used to read and write the `cache` table, because Laravel's rate limiter uses the
# cache store. At 500 req/s that was ~1,000 writes/s on one InnoDB table — the first wall, and not one more
# cores would have moved.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Sessions go to the NON-EVICTING instance, not the cache: allkeys-lru would drop an admin's session to
# make room for a cached leaderboard, and an admin logged out mid-event is the kind of failure that looks
# like a bug in the app.
SESSION_CONNECTION=persistent
REDIS_SESSION_DB=2

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false   # true once TLS is on
SESSION_DOMAIN=

FILESYSTEM_DISK=local
LOG_CHANNEL=stderr            # containers log to stdout; docker keeps them
LOG_LEVEL=info

# --- the load harness refuses to run without this; leave it unset for a real event ---
# LOADTEST=1

# --- the partner connector stays off between events (see PartnerConnector) ---
PARTNER_BASE_URL=
PARTNER_API_KEY=
PARTNER_ADMIN_NAME=Questerra

# --- host ports ---
HTTP_PORT=80
HTTPS_PORT=443
