# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# IMPORTANT: Copy this to .env and update with your actual production values
# DO NOT commit the actual .env file with real credentials to version control

APP_NAME=EUREKA
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://eureka-performa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

# Security: Use strong bcrypt rounds for production
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single,errorlog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration - UPDATE WITH YOUR ACTUAL CREDENTIALS
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_secure_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB
DB_TIMEOUT=30
DB_PERSISTENT=false

# Session Configuration - Secure for production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=eureka-performa.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Broadcasting
BROADCAST_CONNECTION=log

# File Storage
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION=database

# Cache Configuration - Consider Redis for better performance
CACHE_STORE=database
CACHE_PREFIX=eureka_
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks

# Redis Configuration (recommended for production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Mail Configuration - UPDATE WITH YOUR ACTUAL MAIL SERVER
MAIL_MAILER=smtp
MAIL_HOST=your_actual_smtp_server.com
MAIL_PORT=587
MAIL_USERNAME=your_actual_email@yourdomain.com
MAIL_PASSWORD=your_actual_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@eureka-performa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security Headers
SECURE_HEADERS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT=60

# File Upload Limits
MAX_FILE_SIZE=10240
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=10M
MAX_EXECUTION_TIME=300

# Trusted Proxies (configure if behind load balancer)
# TRUSTED_PROXIES=*
# TRUSTED_HOSTS=eureka-performa.com

# AWS Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production Performance Optimization
VIEW_CACHE_ENABLED=true
CONFIG_CACHE_ENABLED=true
ROUTE_CACHE_ENABLED=true
EVENT_CACHE_ENABLED=true

# Queue Configuration for Production
QUEUE_FAILED_TABLE=failed_jobs

# Laravel Telescope (disable in production)
TELESCOPE_ENABLED=false

# Error Tracking (configure as needed)
# SENTRY_LARAVEL_DSN=your_sentry_dsn_here
# BUGSNAG_API_KEY=your_bugsnag_key_here

# Backup Configuration (if using spatie/laravel-backup)
# BACKUP_ARCHIVE_PASSWORD=your_secure_backup_password_here